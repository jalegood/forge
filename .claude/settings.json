{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "echo 'File written \u2014 add lint/format command here for your stack'"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash .forge/scripts/hook-status-lint.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .forge/scripts/guard-push.sh"
          },
          {
            "type": "command",
            "command": "bash .forge/scripts/guard-branch.sh"
          },
          {
            "type": "command",
            "command": "bash .forge/scripts/guard-secrets.sh"
          }
        ]
      }
    ]
  }
}
